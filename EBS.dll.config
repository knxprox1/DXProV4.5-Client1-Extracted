            <!--<add name="EventLog" type="System.Diagnostics.EventLogTraceListener" initializeData="APPLICATION_NAME"/> -->
        </sharedListeners>
    </system.diagnostics>
    <userSettings>
        <EBS.My.MySettings>
            <setting name="Margins" serializeAs="String">
                <value>30, 30, 30, 30</value>
            </setting>
            <setting name="MessageRSSPeriod" serializeAs="String">
                <value>23:59:59</value>
            </setting>
            <setting name="LoadCashedTables" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="StartLocal" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="SQLDbCashed" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="SlowUpload" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="FastLoad" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="CompressData" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="SQLLiteCashed" serializeAs="String">
                <value>False</value>
            </setting>
        </EBS.My.MySettings>
    </userSettings>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1"/></startup>
