        </binding>
        <!--END-OF-CHAT-SERVICE-->      
      </netTcpBinding>
    </bindings>
    <client>
      <endpoint address="net.tcp://localhost:5586/TraderService" binding="netTcpBinding"
        bindingConfiguration="netTcpBindingEndpoint" contract="TraderService.IService" behaviorConfiguration="myEndPointBehavior"
        name="netTcpBindingEndpoint">
        <identity>
          <dns value="localhost" />
        </identity>
      </endpoint>
      <!--START-OF-CHAT-SERVICE-->
      <endpoint address="net.tcp://localhost:1234/Chat/ChatService"
          binding="netTcpBinding" bindingConfiguration="NetTcpBinding_ISendChatService1"
          contract="ServiceReference1.ISendChatService" name="NetTcpBinding_ISendChatService1" />
      <!--END-OF-CHAT-SERVICE-->
    </client>
    <behaviors>
    <endpointBehaviors>
      <behavior name="myEndPointBehavior">
        <dataContractSerializer maxItemsInObjectGraph="2147483647" />                 
      </behavior>
    </endpointBehaviors>
    </behaviors>
  </system.serviceModel>
